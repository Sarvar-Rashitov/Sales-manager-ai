# ============================================================
# AI Sales Manager — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Site URL (used for email links)
SITE_URL=http://localhost:8002

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Telegram MTProto API
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=33640185
TELEGRAM_API_HASH=abf3e4b71a4f8bc128df45eef84e1d58

# ---- Production only (PostgreSQL) ----
# DB_NAME=ai_sales_manager
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ---- Production only (Email) ----
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
